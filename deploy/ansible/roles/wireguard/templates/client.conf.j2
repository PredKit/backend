[Interface]
PrivateKey = {{ item.1.content | b64decode | trim }}
Address = {{ item.0.vpn_ip }}/24
DNS = 1.1.1.1, 1.0.0.1

[Peer]
PublicKey = {{ server_pubkey_result.stdout }}
Endpoint = {{ wireguard_server_ip }}:{{ wireguard_port }}
# Only route VPN traffic through the tunnel (not all internet traffic)
AllowedIPs = {{ wireguard_network }}
PersistentKeepalive = 25

